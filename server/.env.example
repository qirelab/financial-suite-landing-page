# Contact form API (server/index.mjs) — Brevo transactional email
# On the VPS these values live in /var/www/f-suite-api/.env (chmod 600), never in git.

# Brevo API key (Brevo > SMTP & API > API Keys). Secret!
BREVO_API_KEY=xkeysib-********

# Sender — must be on the domain verified in Brevo
MAIL_FROM=noreply@f-suite.com
MAIL_FROM_NAME=Financial Suite

# Address that receives form submissions
MAIL_TO=********@f-suite.com

# Where the API listens (nginx proxies /api/ here)
HOST=127.0.0.1
PORT=1804
