# Contact form API (server/index.mjs) — Brevo SMTP relay
# On the VPS these values live in /var/www/f-suite-api/.env (chmod 600), never in git.

# Brevo > SMTP & API > SMTP tab
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=********@smtp-brevo.com
# SMTP key (xsmtpsib-...), not the API key. Secret!
SMTP_PASS=xsmtpsib-********

# Sender — must be on the domain verified in Brevo
SMTP_FROM=noreply@f-suite.com

# Address that receives form submissions
CONTACT_TO=********@f-suite.com

# Where the API listens (nginx proxies /api/ here)
HOST=127.0.0.1
PORT=1804
